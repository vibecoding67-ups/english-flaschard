exports[`StreakBadge snapshots > renders streak 0 with no last date 1`] = `
"<div data-v-0ad213de="" class="streak-badge">
  <div data-v-0ad213de="" class="streak-main"><span data-v-0ad213de="" class="streak-fire" aria-hidden="true">🔥</span>
    <div data-v-0ad213de="" class="streak-info"><span data-v-0ad213de="" class="streak-count" aria-label="\`\${streak} hari berturut-turut\`">0</span><span data-v-0ad213de="" class="streak-label">hari berturut-turut</span></div>
    <!--v-if-->
  </div>
  <div data-v-0ad213de="" class="streak-date"><span data-v-0ad213de="" class="date-text date-text--empty"> Belum pernah belajar </span></div>
  <!--v-if-->
</div>"
`;

exports[`StreakBadge snapshots > renders streak 7 (milestone) 1`] = `
