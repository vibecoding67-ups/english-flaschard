// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`FlashcardItem snapshots > renders with status mastered 1`] = `
"<article data-v-e8973c3b="" class="flashcard-item flashcard-item--mastered">
  <div data-v-e8973c3b="" class="card-header">
    <h3 data-v-e8973c3b="" class="card-word">ephemeral</h3><span data-v-e8973c3b="" class="status-badge status-badge--mastered" aria-label="Status: Hafal">Hafal ✓</span>
  </div>
  <div data-v-e8973c3b="" class="card-body">
    <p data-v-e8973c3b="" class="card-meaning"><span data-v-e8973c3b="" class="field-label">Arti:</span> berlangsung singkat</p>
    <p data-v-e8973c3b="" class="card-example"><span data-v-e8973c3b="" class="field-label">Contoh:</span><em data-v-e8973c3b="">The ephemeral beauty of cherry blossoms.</em></p>
  </div>
  <div data-v-e8973c3b="" class="card-footer"><span data-v-e8973c3b="" class="card-date">Ditambahkan 15 Jun 2025</span>
    <div data-v-e8973c3b="" class="card-actions"><button data-v-e8973c3b="" class="btn btn-status btn-status--review" type="button">Tandai Perlu Diulang</button><button data-v-e8973c3b="" class="btn btn-delete" type="button" aria-label="\`Hapus flashcard \${card.word}\`"> 🗑️ Hapus </button></div>
  </div>
</article>"
`;

