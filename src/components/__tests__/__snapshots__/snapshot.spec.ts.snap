exports[`SessionSummary snapshots > renders all mastered 1`] = `
"<div data-v-5361ae24="" class="session-summary session-summary--perfect">
  <!-- Celebratory header for perfect score -->
  <div data-v-5361ae24="" class="perfect-banner" role="status" aria-live="polite"><span data-v-5361ae24="" class="perfect-emoji" aria-hidden="true">🎉</span>
    <h2 data-v-5361ae24="" class="perfect-title">Luar Biasa! Semua Hafal!</h2>
    <p data-v-5361ae24="" class="perfect-subtitle">Kamu berhasil menghafal semua kata dalam sesi ini.</p>
  </div><!-- Stats grid -->
  <div data-v-5361ae24="" class="stats-grid" role="list" aria-label="Hasil sesi quiz">
    <div data-v-5361ae24="" class="stat-card stat-card--total" role="listitem"><span data-v-5361ae24="" class="stat-value">5</span><span data-v-5361ae24="" class="stat-label">Total Kartu</span></div>
    <div data-v-5361ae24="" class="stat-card stat-card--mastered" role="listitem"><span data-v-5361ae24="" class="stat-value">5</span><span data-v-5361ae24="" class="stat-label">Hafal ✓</span></div>
    <div data-v-5361ae24="" class="stat-card stat-card--review" role="listitem"><span data-v-5361ae24="" class="stat-value">0</span><span data-v-5361ae24="" class="stat-label">Perlu Diulang</span></div>
  </div><!-- Percentage bar -->
  <div data-v-5361ae24="" class="progress-section" aria-label="Persentase hafal">
    <div data-v-5361ae24="" class="progress-header"><span data-v-5361ae24="" class="progress-label">Persentase Hafal</span><span data-v-5361ae24="" class="progress-value">100%</span></div>
    <div data-v-5361ae24="" class="progress-bar" role="progressbar" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100">
      <div data-v-5361ae24="" class="progress-fill progress-fill--perfect" style="width: 100%;"></div>
    </div>
  </div><!-- Action buttons -->
  <div data-v-5361ae24="" class="summary-actions"><button data-v-5361ae24="" type="button" class="btn btn-restart"> 🔄 Quiz Lagi </button><button data-v-5361ae24="" type="button" class="btn btn-home"> 🏠 Ke Dashboard </button></div>
</div>"
`;

